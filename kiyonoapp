# -*- coding: utf-8 -*-
import time

class CanteenApp:
    def __init__(self):
        self.lanes = {
            "1": {"name": "1列目：カレー・うどん", "base_wait": 2, "eating_time": 5, "selected_count": 0},
            "2": {"name": "2列目：からあげ丼・日替わり", "base_wait": 12, "eating_time": 8, "selected_count": 0},
            "3": {"name": "3列目：ラーメン・混ぜそば", "base_wait": 15, "eating_time": 10, "selected_count": 0},
            # いつでも選べる選択肢としてコンビニを常時組み込む
            "c": {"name": "コンビニ・売店（常時確実）", "base_wait": 0, "eating_time": 3, "selected_count": 0}
        }
        self.add_seconds_per_selection = 45

    def get_current_wait_time(self, lane_key):
        # コンビニは待ち時間0分で固定
        if lane_key == "c":
            return 0.0
        
        lane = self.lanes[lane_key]
        additional_minutes = (lane["selected_count"] * self.add_seconds_per_selection) / 60.0
        return lane["base_wait"] + additional_minutes

    def decay_selected_counts(self):
        """時間が経過（1ループ）したとみなし、学食の列の消化を進めて選択人数を1人減らす（0未満にはしない）"""
        for key in self.lanes:
            if key != "c" and self.lanes[key]["selected_count"] > 0:
                self.lanes[key]["selected_count"] -= 1

    def run(self):
        print("=== 学食混雑分散アプリ（Canteen Optimizer） ===")
        while True:
            try:
                user_input = input("\nあと何分で昼食を終えたいですか？（分数を入力、終了はq）: ")
                if user_input.lower() == 'q':
                    print("アプリを終了します。")
                    break
                
                target_time = float(user_input)
            except ValueError:
                print("有効な数値を入力してください。")
                continue

            # 判定を行うたびに学食の列の消化（減衰）を行う
            self.decay_selected_counts()

            # すべての選択肢（学食レーン ＋ コンビニ）を評価する
            valid_options = []
            for key, lane in self.lanes.items():
                wait_time = self.get_current_wait_time(key)
                total_time = wait_time + lane["eating_time"]
                
                if total_time <= target_time:
                    valid_options.append({
                        "key": key,
                        "name": lane["name"],
                        "total_time": total_time,
                        "wait_time": wait_time
                    })

            print(f"\n--- 【判定結果】（目標: {target_time}分以内） ---")
            if valid_options:
                print("以下の選択肢が間に合います：")
                for opt in valid_options:
                    if opt['key'] == 'c':
                        print(f"[{opt['key']}] 🛒 {opt['name']} (予想所要時間: 約 {opt['total_time']:.1f} 分 / 待ち: {opt['wait_time']:.1f}分)")
                    else:
                        print(f"[{opt['key']}] 🍛 {opt['name']} (予想所要時間: 約 {opt['total_time']:.1f} 分 / 待ち: {opt['wait_time']:.1f}分)")
                
                choice = input("\nどの選択肢にしますか？（番号を入力 / キャンセルはc、またはq）: ")
                if choice in self.lanes and choice != "c":
                    self.lanes[choice]["selected_count"] += 1
                    print(f"-> {self.lanes[choice]['name']} が選択されました。リアルタイムで混雑状況（待ち時間）を更新しました。")
                elif choice == "c":
                    print("-> 『コンビニ・売店』が選択されました。確実に時間内に昼食を完了できます！")
                else:
                    print("選択がキャンセルされました。")
            else:
                print("⚠️ 現在、どの学食のレーンも目標時間内に間に合いません。")
                print("【推奨】 時間が非常にタイトなため、今回は『c：コンビニ・売店』の利用を強く推奨します！")

if __name__ == "__main__":
    app = CanteenApp()
    app.run()
